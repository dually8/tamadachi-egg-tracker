{
  "name": "tamadachi-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "node setup-standalone.mjs",
    "prestart": "pnpm run build",
    "start": "node ./.next/standalone/server.js",
    "start:nobuild": "node ./.next/standalone/server.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:install:pi": "playwright install --with-deps chromium",
    "test:install:pi:firefox": "playwright install --with-deps firefox",
    "test:headed": "xvfb-run -a playwright test --project=chromium --headed --workers=1",
    "test:edge": "playwright test --project=\"Microsoft Edge\"",
    "test:traderjoes:firefox": "playwright test tests/traderjoes.spec.ts --project=firefox",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --headed --debug --workers=1",
    "test:report": "playwright show-report --host 0.0.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@tanstack/react-table": "^8.21.2",
    "ag-charts-community": "^11.1.1",
    "ag-charts-react": "^11.1.1",
    "ag-grid-community": "^33.1.1",
    "ag-grid-react": "^33.1.1",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.1",
    "lucide-react": "^0.483.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.58.2",
    "prettier": "3.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}

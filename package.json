{
  "name": "tamadachi-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "playwright install --with-deps",
    "build": "next build",
    "postbuild": "node setup-standalone.mjs",
    "prestart": "pnpm run build",
    "start": "node ./.next/standalone/server.js",
    "start:nobuild": "node ./.next/standalone/server.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "vitest run",
    "test:db:watch": "vitest",
    "test": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:firefox:headed": "xvfb-run -a playwright test --project=firefox --headed --workers=1",
    "test:install:pi": "playwright install --with-deps chromium",
    "test:install:pi:firefox": "playwright install --with-deps firefox",
    "test:headed": "xvfb-run -a playwright test --project=chromium --headed --workers=1",
    "test:edge": "playwright test --project=\"Microsoft Edge\"",
    "test:traderjoes:firefox": "playwright test tests/traderjoes.spec.ts --project=firefox",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --headed --debug --workers=1",
    "test:report": "playwright show-report --host 0.0.0.0",
    "db:dedupe": "tsx scripts/dedupe-daily-prices.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-table": "^8.21.3",
    "ag-charts-community": "^11.3.2",
    "ag-charts-react": "^11.3.2",
    "ag-grid-community": "^33.3.2",
    "ag-grid-react": "^33.3.2",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.483.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}

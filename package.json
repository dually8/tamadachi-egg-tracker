{
  "name": "tamadachi-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "node setup-standalone.mjs",
    "prestart": "pnpm run build",
    "start": "node ./.next/standalone/server.js",
    "start:nobuild": "node ./.next/standalone/server.js",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "playwright test --project=chromium",
    "test:install:pi": "playwright install --with-deps chromium",
    "test:headed": "xvfb-run -a playwright test --project=chromium --headed --workers=1",
    "test:edge": "playwright test --project=\"Microsoft Edge\"",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --headed --debug --workers=1",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@tanstack/react-table": "^8.21.2",
    "ag-charts-community": "^11.1.1",
    "ag-charts-react": "^11.1.1",
    "ag-grid-community": "^33.1.1",
    "ag-grid-react": "^33.1.1",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.1",
    "lucide-react": "^0.483.0",
    "next": "15.4.8",
    "next-themes": "^0.4.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "prettier": "3.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "@types/react": "19.1.10",
      "@types/react-dom": "19.1.7",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
      "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2",
      "@eslint/plugin-kit@<0.3.4": ">=0.3.4",
      "tar-fs@>=2.0.0 <2.1.4": ">=2.1.4",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1"
    }
  }
}
